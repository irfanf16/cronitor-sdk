# Entity: monitor

main: kit: entity: monitor: {

  alias: field: {}

  fields: {
    assertions: {
      h: "Assertions"
      n: "assertions"
      r: false
      sh: "Assertions such as \"response.code = 200\" or \"metric.queue_depth < 100\"."
      t: "`$ARRAY`"
    }
    attributes: {
      h: "Attributes"
      n: "attributes"
      r: true
      ro: true
      sh: "Values derived from the monitor configuration."
      t: "`$OBJECT`"
    }
    badges: {
      h: "Badges"
      n: "badges"
      r: true
      ro: true
      t: "`$OBJECT`"
    }
    consecutive_alert_threshold: {
      h: "Consecutive Alert Threshold"
      n: "consecutive_alert_threshold"
      r: false
      t: "`$INTEGER`"
    }
    created: {
      fo: "date-time"
      h: "Created"
      n: "created"
      r: true
      ro: true
      t: "`$STRING`"
    }
    defaultName: {
      h: "Default Name"
      n: "defaultName"
      r: false
      t: "`$STRING`"
      wo: true
    }
    defaultNote: {
      h: "Default Note"
      n: "defaultNote"
      r: false
      t: "`$STRING`"
      wo: true
    }
    disabled: {
      h: "Disabled"
      n: "disabled"
      r: true
      ro: true
      t: "`$BOOLEAN`"
    }
    environments: {
      h: "Environments"
      n: "environments"
      r: false
      t: "`$ARRAY`"
    }
    failure_tolerance: {
      h: "Failure Tolerance"
      n: "failure_tolerance"
      r: false
      sh: "Failures tolerated before an alert."
      t: "`$INTEGER`"
    }
    grace_seconds: {
      h: "Grace Seconds"
      n: "grace_seconds"
      r: false
      sh: "Seconds to wait after a missed or late event before alerting."
      t: "`$INTEGER`"
    }
    group: {
      h: "Group"
      n: "group"
      r: false
      sh: "Group key."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    initialized: {
      h: "Initialized"
      n: "initialized"
      r: true
      ro: true
      sh: "Whether the monitor has received telemetry."
      t: "`$BOOLEAN`"
    }
    key: {
      h: "Key"
      n: "key"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        list: {
          req: false
          type: "`$STRING`"
        }
        load: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Unique monitor key."
      t: "`$STRING`"
    }
    latest_event: {
      h: "Latest Event"
      n: "latest_event"
      r: true
      ro: true
      sh: "Present when the request has withStatus=true (the default)."
      t: "`$ANY`"
    }
    latest_events: {
      h: "Latest Events"
      n: "latest_events"
      r: true
      ro: true
      sh: "Latest event of each kind, keyed by event name."
      t: "`$OBJECT`"
    }
    latest_invocations: {
      h: "Latest Invocations"
      n: "latest_invocations"
      r: true
      ro: true
      sh: "Present with withInvocations=true."
      t: "`$ARRAY`"
    }
    latest_issue: {
      h: "Latest Issue"
      n: "latest_issue"
      r: true
      ro: true
      t: "`$OBJECT`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: false
      t: "`$STRING`"
    }
    metric_names: {
      h: "Metric Names"
      n: "metric_names"
      r: true
      ro: true
      t: "`$ARRAY`"
    }
    monitor_list: {
      h: "Monitor List"
      n: "monitor_list"
      r: false
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    next_expected_at: {
      h: "Next Expected At"
      n: "next_expected_at"
      r: true
      ro: true
      sh: "Unix timestamp of the next scheduled run."
      t: "`$NUMBER`"
    }
    note: {
      h: "Note"
      n: "note"
      r: false
      t: "`$STRING`"
    }
    notify: {
      h: "Notify"
      n: "notify"
      r: false
      sh: "Notification list keys or inline destinations such as \"email:ops@example.com\"."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 2
        depth: 4
      }
    }
    passing: {
      h: "Passing"
      n: "passing"
      r: true
      ro: true
      sh: "Present when the request has withStatus=true (the default)."
      t: "`$BOOLEAN`"
    }
    paused: {
      h: "Paused"
      n: "paused"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        list: {
          req: false
          type: "`$BOOLEAN`"
        }
        load: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      t: "`$BOOLEAN`"
    }
    paused_until: {
      fo: "date-time"
      h: "Paused Until"
      n: "paused_until"
      r: true
      t: "`$STRING`"
    }
